// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// User Model
// ==========================================
model User {
  id         String      @id @default(uuid())
  email      String      @unique
  username   String      @unique
  password   String
  characters Character[]
  campaigns  Campaign[]  // משתמש יכול לנהל/להחזיק מספר מערכות
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ==========================================
// Campaign Model
// ==========================================
model Campaign {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      String      @default("active") // "active" | "completed"
  bgUrl       String      @default("https://images.unsplash.com/photo-1518709268805-4e9042af9f23")
  
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  characters  Character[]
  summaries  Summary[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ==========================================
// Character Model
// ==========================================
model Character {
  id               String    @id @default(uuid())
  
  // מזהה ייחודי מ מול D&D Beyond
  beyondId         String    @unique 
  
  // מידע בסיסי
  name             String
  player           String    @default("Player")
  avatarUrl        String?
  race             String?
  className        String?   
  subclass         String?  
  level            Int       @default(1)
  proficiencyBonus Int       @default(2)
  initiative       Int       @default(0)
  
  // מדדי נתונים
  currentHp        Int?
  maxHp            Int?
  tempHp           Int?      @default(0)
  armorClass       Int?     
  speed            Int?      @default(30)
  
  // מבני נתונים מורכבים בפורמט JSON
  stats            Json?     
  equipment        Json?     
  spells           Json?     
  features         Json?     
  
  // קישור למשתמש (בעלים)
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // קישור למערכה (Campaign)
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
// ==========================================
// Character Sheet
// ==========================================
model CharacterSheet {
  id          String   @id @default(uuid())
  campaignId  String
  name        String   // שם הדמות (למשל: "Gorgar")
  pdfData     Bytes    // ה-PDF נשמר ישירות ב-DB כ-Buffer
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, name]) // מקור יחידי לדמות אחת בקמפיין
}
// ==========================================
// campaign Summary
// ==========================================
model Summary {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  createdVia  String   // 'MANUAL' | 'ON_DEMAND' | 'AUTO'
  pdfUrl      String?  // במידה ונשמר כקובץ/נתיב
  createdAt   DateTime @default(now())
}