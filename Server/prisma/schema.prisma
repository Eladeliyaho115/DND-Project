// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// User Model
// ==========================================
model User {
  id         String      @id @default(uuid())
  email      String      @unique
  username   String      @unique
  password   String
  characters Character[]
  campaigns  Campaign[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ==========================================
// Campaign Model
// ==========================================
model Campaign {
  id            String        @id @default(uuid())
  title         String
  description   String?
  status        String        @default("active")
  bgUrl         String        @default("https://images.unsplash.com/photo-1518709268805-4e9042af9f23")
  mapUrl        String?       @default("https://media.discordapp.net/attachments/1019738816350781451/1531667737682772051/fantasy_world_map.png?ex=6a6a0c3d&is=6a68babd&hm=7e25396e85fe405c470bfbd5e7358284d2f11f3bb9978fa7513be7d475db5a50&=&format=webp&quality=lossless&width=930&height=698")
  masterSummary String?       @db.Text // 🟢 זיכרון לטווח ארוך (Master Campaign Summary)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  characters    Character[]
  summaries     Summary[]
  chatSessions  ChatSession[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ==========================================
// Character Model
// ==========================================
model Character {
  id               String    @id @default(uuid())
  beyondId         String    @unique 
  name             String
  player           String    @default("Player")
  avatarUrl        String?
  race             String?
  className        String?   
  subclass         String?   
  level            Int       @default(1)
  proficiencyBonus Int       @default(2)
  initiative       Int       @default(0)
  currentHp        Int?
  maxHp            Int?
  tempHp           Int?      @default(0)
  armorClass       Int?      
  speed            Int?      @default(30)
  stats            Json?     
  equipment        Json?     
  spells           Json?     
  features         Json?     
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ==========================================
// Character Sheet
// ==========================================
model CharacterSheet {
  id            String   @id @default(uuid())
  campaignId    String
  name          String   
  pdfData       Bytes    
  parsedContent String?  @db.Text
  updatedAt     DateTime @updatedAt

  @@unique([campaignId, name])
}

// ==========================================
// Campaign Summary
// ==========================================
model Summary {
  id            String       @id @default(uuid())
  campaignId    String
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  content       String       @db.Text
  parsedContent String?      @db.Text
  createdVia    String       
  pdfUrl        String?      @db.Text
  createdAt     DateTime     @default(now())
}

// ==========================================
// Chat Session Model
// ==========================================
model ChatSession {
  id          String        @id @default(uuid())
  title       String        @default("שיחה חדשה")
  campaignId  String
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  summaries   Summary[]     
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ==========================================
// Chat Message Model
// ==========================================
model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String
  chatSession ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender      String      
  text        String      @db.Text
  createdAt   DateTime    @default(now())
}